<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lapis</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lapis.Editor" />
    <InternalsVisibleTo Include="Lapis.Runtime" />
    <InternalsVisibleTo Include="Lapis.Tests" />
    <InternalsVisibleTo Include="Lapis.Editor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="StbImageWriteSharp" />
    <PackageReference Include="JoltPhysicsSharp" />
    <PackageReference Include="SharpGLTF.Core" />
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="StbTrueTypeSharp" />
    <PackageReference Include="DotRecast.Core" />
    <PackageReference Include="DotRecast.Recast" />
    <PackageReference Include="DotRecast.Detour" />
    <PackageReference Include="DotRecast.Detour.Crowd" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in shaders are copied next to every app that references the engine -->
    <None Include="Shaders\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Shaders" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default font of in-game text (SIL Open Font License, see scripts/package/licenses) -->
    <EmbeddedResource Include="Fonts\Lato-Regular.ttf" LogicalName="Lapis.Fonts.Lato-Regular.ttf" />
  </ItemGroup>

</Project>

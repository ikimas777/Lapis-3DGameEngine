<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- scripts/publish-editor.ps1 builds a windowed app without a console window. -->
    <OutputType Condition="'$(LapisWindowedApp)' == 'true'">WinExe</OutputType>
    <RootNamespace>Lapis.Editor</RootNamespace>
    <AssemblyTitle>Lapis Editor</AssemblyTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lapis\Lapis.csproj" />
    <InternalsVisibleTo Include="Lapis.Editor.Tests" />
    <!-- The MCP server (Mcp/McpServerHost.cs) runs on ASP.NET Core's Kestrel. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" />
    <PackageReference Include="Hexa.NET.ImGuizmo" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

</Project>

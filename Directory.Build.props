<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <SelfContained>false</SelfContained>

    <!-- Any CPU, so builds run on x64 and on Apple Silicon (arm64); dotnet publish -r picks the processor. -->
    <PlatformTarget Condition="$(RuntimeIdentifier.EndsWith('-x64'))">x64</PlatformTarget>
    <PlatformTarget Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.Substring($([MSBuild]::Add($(RuntimeIdentifier.LastIndexOf('-')), 1))))</PlatformTarget>

    <Version>0.10.0</Version>
    <Authors>Lapis contributors</Authors>
    <Copyright>Copyright (c) 2026 Lapis contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>

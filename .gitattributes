# Text files are stored with LF and checked out with LF on every system (also on Windows with core.autocrlf),
# so files never mix line endings. .editorconfig says the same for editors.
* text=auto eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.glb binary
*.wav binary
*.ogg binary
*.ico binary
